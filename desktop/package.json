{
  "name": "agentflux-desktop",
  "version": "1.0.0",
  "description": "AgentFlux Desktop Application",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "electron:compile": "tsc -p tsconfig.electron.json && node -e \"require('fs').writeFileSync('dist-electron/package.json','{\\\"type\\\":\\\"commonjs\\\"}')\"",
    "electron:dev": "npm run electron:compile && concurrently -k -n vite,electron -c yellow,cyan \"vite --host\" \"wait-on http://localhost:5173 && cross-env NODE_ENV=development electron .\"",
    "electron:debug": "npm run electron:compile && concurrently -k -n vite,electron -c yellow,cyan \"vite --host\" \"wait-on http://localhost:5173 && cross-env NODE_ENV=development electron --inspect=9229 .\"",
    "electron:build": "npm run build && npm run electron:compile && electron-builder",
    "test:data": "node -e \"const{parseEventsFile}=require('./src/lib/events-parser.ts');console.log('Events:',parseEventsFile(process.env.AGENTFLUX_PROJECT_ROOT+'/.agentflux/events.jsonl').length)\"",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "recharts": "^2.12.7",
    "zustand": "^4.5.4"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.4.19",
    "concurrently": "^8.2.2",
    "cross-env": "^7.0.3",
    "electron": "^31.3.1",
    "electron-builder": "^24.13.3",
    "jsdom": "^29.1.1",
    "postcss": "^8.4.39",
    "tailwindcss": "^3.4.6",
    "typescript": "^5.5.3",
    "vite": "^5.3.4",
    "vitest": "^4.1.9",
    "wait-on": "^7.2.0"
  },
  "type": "module"
}
